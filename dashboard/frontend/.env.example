# Backend WebSocket Server URL
# In production / LAN testing, set to: ws://<YOUR_COMPUTER_LAN_IP>:3001
VITE_WS_URL=ws://localhost:3001

# Backend HTTP API URL
VITE_API_URL=http://localhost:3001

# Demo mode toggle (true = simulate sensor data without ESP32, false = real ESP32 stream)
VITE_DEMO_MODE=false
